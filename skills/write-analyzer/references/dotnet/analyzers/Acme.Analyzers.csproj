<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MUSÍ být netstandard2.0; analyzer běží uvnitř kompilátoru,
         ne v tvé aplikaci. Cílení na net10.0 způsobí, že se analyzer
         tiše nenačte. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>

    <!-- Analyzer sám nechceme analyzovat vlastními pravidly -->
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- RS2008 (release tracking) je pro in-repo analyzer zbytečná režie -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!-- Test projekt žije ve vnořené složce; bez exclude by ho
       defaultní glob kompiloval i do analyzeru samotného. -->
  <ItemGroup>
    <Compile Remove="Acme.Analyzers.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verze jsou v Directory.Packages.props (CPM); atribut Version zde
         by pod CPM způsobil NU1008. Volit NEJNIŽŠÍ verzi, která pokrývá
         use case; vyšší verze znamená, že analyzer nepoběží ve starších SDK. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
