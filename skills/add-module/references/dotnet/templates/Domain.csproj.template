<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Acme.__MODULE__.Domain</RootNamespace>
    <AssemblyName>Acme.__MODULE__.Domain</AssemblyName>
  </PropertyGroup>

  <!-- Doména nemá ŽÁDNÉ package reference kromě analyzerů.
       Pokud sem potřebuješ něco přidat, je to skoro jistě signál,
       že ten koncept patří do aplikační vrstvy. -->

  <ItemGroup>
    <InternalsVisibleTo Include="Acme.__MODULE__.Application" />
    <InternalsVisibleTo Include="Acme.__MODULE__.Infrastructure" />
    <InternalsVisibleTo Include="Acme.__MODULE__.Tests" />
  </ItemGroup>

</Project>
