<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Architektonické testy sledují jiná pravidla než produkční kód.
         Nechceme, aby analyzery hlásily coupling v testu, který
         schválně sahá na všechno. -->
    <AnalysisMode>Minimum</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1861;xUnit1042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

  <!--
    DŮLEŽITÉ: testy musí referencovat VŠECHNY modulové projekty,
    jinak je Conventions.DiscoverModules() nenajde.

    Buď explicitně:
      <ProjectReference Include="..\..\src\Modules\Orders\*\*.csproj" />

    Nebo globem přes všechny moduly (funguje, pokud dodržuješ konvenci cest):
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\**\*.csproj" />
    <ProjectReference Include="..\..\src\Host\*.csproj" Condition="Exists('..\..\src\Host')" />
  </ItemGroup>

</Project>
