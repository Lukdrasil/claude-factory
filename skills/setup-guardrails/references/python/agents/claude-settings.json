{
  "_comment": "Copy into the target repo's .claude/settings.json. A harder barrier than AGENTS.md; the agent physically cannot touch the quality config.",
  "permissions": {
    "deny": [
      "Edit(ruff.toml)",
      "Write(ruff.toml)",
      "Edit(pyrightconfig.json)",
      "Write(pyrightconfig.json)",
      "Edit(.importlinter)",
      "Write(.importlinter)",
      "Edit(.pre-commit-config.yaml)",
      "Write(.pre-commit-config.yaml)",
      "Edit(.gitlab-ci.yml)",
      "Write(.gitlab-ci.yml)"
    ],
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pyright:*)",
      "Bash(pytest:*)",
      "Bash(lint-imports:*)"
    ]
  }
}
